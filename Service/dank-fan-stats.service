[Unit]
Description=Serve MSI EC fan stats and control for Dank Material Shell
After=local-fs.target
ConditionPathExists=/sys/devices/platform/msi-ec

[Service]
Type=simple
Environment=CLIENT_USER=@CLIENT_USER@
Environment=CLIENT_GROUP=@CLIENT_GROUP@
ExecStart=/usr/local/bin/dank-fan-stats-daemon
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
